---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import WindowFrame from '../../components/WindowFrame.astro';
import WebRing from '../../components/WebRing.astro';
import Timestamp from '../../components/Timestamp.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const work = (await getCollection('work')).sort((a, b) => b.data.year - a.data.year);

  return work.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // Newest first, so "previous" is the newer neighbour.
      prev: work[index - 1],
      next: work[index + 1],
    },
  }));
};

/** getStaticPaths props are not inferred into Astro.props — declare them. */
interface Props {
  entry: CollectionEntry<'work'>;
  prev?: CollectionEntry<'work'> | undefined;
  next?: CollectionEntry<'work'> | undefined;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  updated={entry.data.updated}
  ogType="article"
>
  <article>
    <header class="head">
      <p class="crumb small"><a href="/work/">Work</a> / {entry.data.title}</p>

      <h1>{entry.data.title}</h1>
      <p class="measure lede">{entry.data.summary}</p>

      <p class="small meta">
        <span>{entry.data.client ?? 'Studio project'}</span>
        <span>{entry.data.year}</span>
        {entry.data.updated && <Timestamp date={entry.data.updated} />}
      </p>
    </header>

    <WindowFrame
      filename={entry.data.coverFilename ?? `${entry.id}.png`}
      caption={entry.data.coverAlt}
      class="cover"
    >
      <Image src={entry.data.cover} alt={entry.data.coverAlt} width={1200} height={900} />
    </WindowFrame>

    <div class="prose body">
      <Content />
    </div>
  </article>

  <hr />

  <section class="section">
    <WebRing
      label="Case studies"
      allHref="/work/"
      allLabel="All work"
      allIcon="monitor"
      prevLabel="Newer"
      nextLabel="Older"
      endOfRingLabel="End of the ring"
      prev={prev ? { href: `/work/${prev.id}/`, title: prev.data.title } : undefined}
      next={next ? { href: `/work/${next.id}/`, title: next.data.title } : undefined}
    />
  </section>
</BaseLayout>

<style>
  .head {
    padding: 3.5rem 0 2.5rem;
    max-width: 48rem;
  }

  .crumb {
    margin-bottom: 1rem;
  }

  .crumb a {
    color: var(--muted);
  }

  .head h1 {
    margin-bottom: 1.25rem;
  }

  .lede {
    font-size: 1.25rem;
    line-height: 1.5;
    margin: 0 0 1.25rem;
  }

  .meta {
    display: flex;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
  }

  :global(.cover) {
    margin-bottom: 3rem;
  }

  .body {
    padding-bottom: 3.5rem;
  }
</style>
