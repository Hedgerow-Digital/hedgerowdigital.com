---
import { getCollection, getEntry, render } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PixelIcon from '../components/PixelIcon.astro';
import ProductCard from '../components/ProductCard.astro';
import Timestamp from '../components/Timestamp.astro';
import { resolveUpdated } from '../lib/last-updated';
import { ctaHref } from '../lib/cta';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('src/content/pages/home.md is missing.');
const { Content } = await render(page);

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
const products = await getCollection('products');

/** The home page names its featured product by slug in home.md. */
const featuredSlug = page.data.sections?.product?.slug;
const featured = featuredSlug
  ? products.find((p) => p.id === featuredSlug)
  : undefined;
if (featuredSlug && !featured) {
  throw new Error(
    `home.md features product "${featuredSlug}", but no such file exists in ` +
      `src/content/products/. Check the slug.`,
  );
}

const { sections } = page.data;
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  updated={resolveUpdated(page.data.updated, page.filePath)}
>
  <section class="hero">
    <h1>{page.data.title}</h1>

    <div class="hero__grid">
      <div>
        <div class="prose">
          <Content />
        </div>

        {
          (page.data.primaryCta || page.data.secondaryCta) && (
            <div class="hero__actions">
              {page.data.primaryCta && (
                <Button href={ctaHref(page.data.primaryCta.href)}>
                  {page.data.primaryCta.label}
                </Button>
              )}
              {page.data.secondaryCta && (
                <Button
                  variant="secondary"
                  href={ctaHref(page.data.secondaryCta.href)}
                >
                  {page.data.secondaryCta.label}
                </Button>
              )}
            </div>
          )
        }
      </div>

      <aside class="hero__aside">
        {page.data.tagline && <p class="tagline">{page.data.tagline}</p>}
        <p class="small">
          {page.data.heroMeta?.map((line) => (
            <>
              {line}
              <br />
            </>
          ))}
          <Timestamp date={resolveUpdated(page.data.updated, page.filePath)} />
        </p>
      </aside>
    </div>
  </section>

  <hr />

  {
    sections?.services && (
      <section class="section">
        <div class="section__head">
          <h2>{sections.services.heading}</h2>
          {sections.services.link && (
            <a href={ctaHref(sections.services.link.href)}>
              {sections.services.link.label}
            </a>
          )}
        </div>
        {sections.services.intro && (
          <p class="small measure intro">{sections.services.intro}</p>
        )}

        <div class="cards">
          {services.map((service) => (
            <article class="card">
              <PixelIcon name={service.data.icon} size={32} />
              <h3 class="card__title">
                <a href={`/services/${service.id}/`}>{service.data.title}</a>
              </h3>
              <p class="card__body">{service.data.summary}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <hr />

  {
    sections?.product && featured && (
      <section class="section">
        <div class="section__head">
          <h2>{sections.product.heading}</h2>
        </div>
        {sections.product.intro && (
          <p class="small measure intro">{sections.product.intro}</p>
        )}
        <ProductCard product={featured} variant="feature" />
      </section>
    )
  }

  {
    sections?.contact && (
      <section class="section">
        <div class="callout">
          <div>
            <h2>{sections.contact.heading}</h2>
            {sections.contact.intro && <p class="measure">{sections.contact.intro}</p>}
          </div>
          <div class="callout__actions">
            {sections.contact.primaryCta && (
              <Button href={ctaHref(sections.contact.primaryCta.href)}>
                {sections.contact.primaryCta.label}
              </Button>
            )}
            {sections.contact.secondaryCta && (
              <a href={ctaHref(sections.contact.secondaryCta.href)}>
                {sections.contact.secondaryCta.label}
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding: 3.5rem 0 3rem;
  }

  .hero h1 {
    margin-bottom: 2.25rem;
    max-width: 56rem;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 2rem 4rem;
    align-items: start;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 1.5rem;
  }

  .hero__aside {
    border-left: 2px solid var(--text);
    padding-left: 1.5rem;
  }

  .hero__aside .tagline {
    margin: 0 0 0.9rem;
  }

  .section__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .section__head p {
    margin: 0;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1.25rem;
  }

  .card {
    border: 2px solid var(--dialup-midnight);
    background: var(--surface);
    border-radius: var(--radius-sm);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .card__title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .card__title a {
    color: var(--text);
    text-decoration: none;
  }

  .card__title a:hover {
    text-decoration: underline;
  }

  .card__body {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
  }

  

  

  

  

  

  

  

  

  /* Cream callout keeps literal colours in both themes. */
  .callout {
    border: 2px solid var(--dialup-midnight);
    background: var(--tooltip-cream);
    color: var(--dialup-midnight);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-hard-md);
    padding: 2.25rem 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem 3rem;
    align-items: center;
  }

  .callout h2 {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }

  /* Plain links inside the cream callout need the literal violet, since the
     callout keeps light-mode colours in both themes. Must exclude .btn — a
     primary button is violet-on-violet otherwise, and its label vanishes. */
  .callout a:not(.btn) {
    color: var(--visited-link);
  }

  .callout__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  @media (max-width: 45rem) {
    .hero__aside {
      border-left: 0;
      border-top: 2px solid var(--text);
      padding-left: 0;
      padding-top: 1.25rem;
    }

  }
</style>
