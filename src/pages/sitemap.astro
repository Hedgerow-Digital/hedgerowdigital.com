---
/**
 * The human sitemap, styled as an Apache "Index of /" listing.
 * (The XML one for crawlers is generated by @astrojs/sitemap.)
 *
 * Sizes and dates are read from the real source files, not invented — an
 * honest directory listing is the whole joke.
 */
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import PixelIcon from '../components/PixelIcon.astro';
import { site } from '../data/site';
import type { PixelIconName } from '../data/pixel-icons';

interface Row {
  name: string;
  href: string;
  icon: PixelIconName;
  modified: Date | undefined;
  size: string;
}

/* Resolve from the project root, not import.meta.url: during `astro build`
   this module is bundled elsewhere and a relative URL no longer points at
   src/content, which silently turned every row into "-". */
const contentRoot = join(process.cwd(), 'src', 'content');

function statContent(relative: string): { modified?: Date; size?: number } {
  try {
    const s = statSync(join(contentRoot, relative));
    return { modified: s.mtime, size: s.size };
  } catch {
    // Not every route has a source file. That is fine.
    return {};
  }
}

function formatSize(bytes: number | undefined): string {
  if (bytes === undefined) return '-';
  if (bytes < 1024) return `${bytes}`;
  return `${(bytes / 1024).toFixed(1)}K`;
}

function formatDate(date: Date | undefined): string {
  if (!date) return '-';
  const iso = date.toISOString();
  return `${iso.slice(0, 10)} ${iso.slice(11, 16)}`;
}

const services = await getCollection('services');
const productEntries = await getCollection('products');
const work = await getCollection('work');

const pageRows: Row[] = [
  { file: 'pages/home.md', name: 'index.html', href: '/' },
  { file: 'pages/about.md', name: 'about.html', href: '/about/' },
  { file: 'pages/contact.md', name: 'contact.html', href: '/contact/' },
].map(({ file, name, href }) => {
  const { modified, size } = statContent(file);
  return { name, href, icon: 'page' as const, modified, size: formatSize(size) };
});

const dirRows: Row[] = [
  {
    name: 'services/',
    href: '/services/',
    icon: 'folder',
    modified: services
      .map((s) => statContent(`services/${s.id}.mdx`).modified)
      .filter((d): d is Date => !!d)
      .sort((a, b) => b.getTime() - a.getTime())[0],
    size: '-',
  },
  {
    name: 'work/',
    href: '/work/',
    icon: 'folder',
    modified: work
      .map((w) => statContent(`work/${w.id}.mdx`).modified)
      .filter((d): d is Date => !!d)
      .sort((a, b) => b.getTime() - a.getTime())[0],
    size: '-',
  },
  {
    name: 'products/',
    href: '/products/',
    icon: 'folder',
    modified: productEntries
      .map((p) => statContent(`products/${p.id}.mdx`).modified)
      .filter((d): d is Date => !!d)
      .sort((a, b) => b.getTime() - a.getTime())[0],
    size: '-',
  },
  { name: 'field-notes/', href: '/field-notes/', icon: 'folder', modified: undefined, size: '-' },
];

const extraRows: Row[] = [
  { name: 'style-guide.html', href: '/style-guide/', icon: 'page', modified: undefined, size: '-' },
  { name: 'sitemap.xml', href: '/sitemap-index.xml', icon: 'page', modified: undefined, size: '-' },
];

const serviceRows: Row[] = services
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => {
    const { modified, size } = statContent(`services/${s.id}.mdx`);
    return {
      name: `${s.id}.html`,
      href: `/services/${s.id}/`,
      icon: 'page' as const,
      modified,
      size: formatSize(size),
    };
  });

const productRows: Row[] = productEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => {
    const { modified, size } = statContent(`products/${p.id}.mdx`);
    return {
      name: `${p.id}.html`,
      href: `/products/${p.id}/`,
      icon: 'page' as const,
      modified,
      size: formatSize(size),
    };
  });

const workRows: Row[] = work.map((w) => {
  const { modified, size } = statContent(`work/${w.id}.mdx`);
  return {
    name: `${w.id}.html`,
    href: `/work/${w.id}/`,
    icon: 'page' as const,
    modified,
    size: formatSize(size),
  };
});
---

<BaseLayout
  title="Sitemap"
  description={`Every page on ${site.name}, listed the way a web server would.`}
>
  <section class="section">
    <div class="dir">
      <h1>Index of /</h1>

      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Last modified</th>
              <th scope="col">Size</th>
            </tr>
          </thead>
          <tbody>
            <tr><td colspan="3"><hr /></td></tr>

            {
              [...dirRows, ...pageRows, ...extraRows].map((row) => (
                <tr>
                  <td>
                    <PixelIcon name={row.icon} size={16} />
                    <a href={row.href}>{row.name}</a>
                  </td>
                  <td>{formatDate(row.modified)}</td>
                  <td>{row.size}</td>
                </tr>
              ))
            }

            <tr><td colspan="3"><hr /></td></tr>
          </tbody>
        </table>
      </div>

      <h2>Index of /products/</h2>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Last modified</th>
              <th scope="col">Size</th>
            </tr>
          </thead>
          <tbody>
            <tr><td colspan="3"><hr /></td></tr>
            {
              productRows.map((row) => (
                <tr>
                  <td>
                    <PixelIcon name={row.icon} size={16} />
                    <a href={row.href}>{row.name}</a>
                  </td>
                  <td>{formatDate(row.modified)}</td>
                  <td>{row.size}</td>
                </tr>
              ))
            }
            <tr><td colspan="3"><hr /></td></tr>
          </tbody>
        </table>
      </div>

      <h2>Index of /services/</h2>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Last modified</th>
              <th scope="col">Size</th>
            </tr>
          </thead>
          <tbody>
            <tr><td colspan="3"><hr /></td></tr>
            {
              serviceRows.map((row) => (
                <tr>
                  <td>
                    <PixelIcon name={row.icon} size={16} />
                    <a href={row.href}>{row.name}</a>
                  </td>
                  <td>{formatDate(row.modified)}</td>
                  <td>{row.size}</td>
                </tr>
              ))
            }
            <tr><td colspan="3"><hr /></td></tr>
          </tbody>
        </table>
      </div>

      <h2>Index of /work/</h2>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Last modified</th>
              <th scope="col">Size</th>
            </tr>
          </thead>
          <tbody>
            <tr><td colspan="3"><hr /></td></tr>
            {
              workRows.map((row) => (
                <tr>
                  <td>
                    <PixelIcon name={row.icon} size={16} />
                    <a href={row.href}>{row.name}</a>
                  </td>
                  <td>{formatDate(row.modified)}</td>
                  <td>{row.size}</td>
                </tr>
              ))
            }
            <tr><td colspan="3"><hr /></td></tr>
          </tbody>
        </table>
      </div>

      <address>{site.serverSignature}</address>
    </div>
  </section>
</BaseLayout>

<style>
  /* Deliberately Times, not Gelica. This page is a server listing. */
  .dir {
    max-width: 48rem;
    font-family: var(--font-directory);
  }

  .dir h1 {
    font-family: var(--font-directory);
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: 0;
    margin: 0 0 0.5rem;
  }

  .dir h2 {
    font-family: var(--font-directory);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2.5rem 0 0.5rem;
  }

  .scroll {
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    font-family: var(--font-directory);
    font-size: 1rem;
    width: 100%;
  }

  th {
    text-align: left;
    font-weight: 700;
    padding: 0.1rem 0.8rem 0.1rem 0;
  }

  td {
    padding: 0.1rem 0.8rem 0.1rem 0;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  td:first-child {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  address {
    font-style: italic;
    font-family: var(--font-directory);
    font-size: 0.95rem;
    margin-top: 1.5rem;
    color: var(--muted);
  }
</style>
