---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import PixelIcon from '../../components/PixelIcon.astro';
import { resolveUpdated } from '../../lib/last-updated';
import { site } from '../../data/site';

export const getStaticPaths: GetStaticPaths = async () => {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
};

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { Content } = await render(product);
const d = product.data;

const action =
  d.ctaHref ?? `mailto:${site.email}?subject=${encodeURIComponent(d.title)}`;
const actionLabel = d.ctaLabel ?? `Ask about the ${d.title}`;

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title={d.title}
  description={d.summary}
  updated={resolveUpdated(d.updated, product.filePath)}
>
  <section class="head">
    <p class="crumb small"><a href="/products/">Products</a> / {d.title}</p>

    <div class="head__grid">
      <div>
        <h1>{d.title}</h1>
        <p class="measure lede">{d.summary}</p>
      </div>

      <div class="price">
        <PixelIcon name={d.icon} size={40} />
        {d.price ? (
          <p class="price__figure">{d.price}</p>
        ) : (
          <p class="price__figure price__figure--tbd">Priced per engagement</p>
        )}
        {d.priceNote && <p class="price__note">{d.priceNote}</p>}
        <Button href={action}>{actionLabel}</Button>
        {d.availability && (
          <p class="price__availability">
            <PixelIcon name="clock" size={14} />
            {d.availability}
          </p>
        )}
      </div>
    </div>
  </section>

  <hr />

  <section class="section">
    <div class="prose">
      <Content />
    </div>
  </section>

  <hr />

  <section class="section">
    <h2>Ongoing work</h2>
    <p class="measure small">
      Products are one-off. These are the services that carry on afterwards.
    </p>
    <ul class="others">
      {services.map((service) => (
        <li>
          <a href={`/services/${service.id}/`}>
            <PixelIcon name={service.data.icon} size={20} />
            {service.data.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .head {
    padding: 3.5rem 0 3rem;
  }

  .crumb {
    margin-bottom: 1rem;
  }

  .crumb a {
    color: var(--muted);
  }

  .head__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 2rem 4rem;
    align-items: end;
  }

  .head h1 {
    margin-bottom: 1.5rem;
  }

  .lede {
    font-size: 1.25rem;
    line-height: 1.5;
    margin: 0;
  }

  .price {
    border: 2px solid var(--dialup-midnight);
    background: var(--tooltip-cream);
    color: var(--dialup-midnight);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-hard-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: flex-start;
    max-width: 22rem;
    width: 100%;
    justify-self: end;
  }

  .price__figure {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 2.75rem;
    line-height: 1;
    margin: 0;
  }

  .price__figure--tbd {
    font-size: 1.5rem;
  }

  .price__note,
  .price__availability {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--status-bar);
  }

  .price__availability {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .others {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
  }

  .others a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    border: 2px solid var(--dialup-midnight);
    background: var(--surface);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1rem;
  }

  .others a:hover {
    text-decoration: underline;
  }

  @media (max-width: 45rem) {
    .price {
      justify-self: stretch;
      max-width: none;
    }
  }
</style>
