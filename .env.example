# Sanity — field notes only. Everything else is Markdown in src/content.
#
# Copy to .env for local development, and set the same values in Vercel's
# project settings so production builds fetch the same dataset.
#
# The values below are the defaults compiled into src/lib/sanity.ts, so the
# site builds without a .env at all. Set them explicitly to point a preview
# build at a different dataset.
#
# Note: the dataset must be readable without a token (Sanity calls this a
# "public" dataset). This build sends no credentials — it only ever reads
# published documents, never drafts.

SANITY_PROJECT_ID=suyliru1
SANITY_DATASET=production
